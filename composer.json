{
    "name": "goncalosoaresdev/filament-monitor",
    "description": "Server, container and application monitoring for Filament, with alerts by Telegram, email and Filament notifications.",
    "keywords": ["laravel", "filament", "monitoring", "alerts", "docker", "telegram"],
    "homepage": "https://github.com/goncalosoaresdev/filament-monitor",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Gonçalo Soares",
            "homepage": "https://github.com/goncalosoaresdev"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.9"
    },
    "autoload": {
        "psr-4": {
            "GoncaloSoares\\FilamentMonitor\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "GoncaloSoares\\FilamentMonitor\\MonitorServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
